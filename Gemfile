source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "jekyll-feed"
gem "jekyll-sitemap"
gem "jekyll-seo-tag"

# Windows does not ship with a native timezone-info database, which Jekyll
# requires to render dates. tzinfo-data supplies it.
gem "tzinfo-data", platforms: [:windows, :jruby]

# Guard against a Jekyll 4.4+/Ruby 4 incompatibility in CSV handling.
gem "csv"
gem "webrick"
